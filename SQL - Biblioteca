CREATE DATABASE Biblioteca;
USE Biblioteca;

CREATE TABLE Autor(
	id_autor INT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    nacionalidade VARCHAR(50)
);

CREATE TABLE Livro(
	id_livro INT PRIMARY KEY,
    titulo VARCHAR(150) NOT NULL,
    ano INT,
    editora VARCHAR(80)
);

CREATE TABLE Aluno(
	id_aluno INT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE,
    curso VARCHAR(50)
);
